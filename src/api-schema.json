  "components": {
    "schemas": {
      "LoginRequest": {
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RegisterRequest": {
        "required": ["email", "password", "passwordRepeat"],
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 180
          },
          "password": {
            "type": "string",
